# ──────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your own values.
# The real .env is gitignored — NEVER commit it (it holds live API keys).
# ──────────────────────────────────────────────────────────────

# LiveKit Cloud (voice transport)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq (LLM)
GROQ_API_KEY=

# Sarvam (Indic STT + TTS)
SARVAM_API_KEY=

# Qdrant Cloud (vector database)
QDRANT_URL=
QDRANT_API_KEY=

# Cloudflare Workers AI (query embeddings)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
